def main():

    conn, cursor = openDB()
    # parse through Messier table
    imageLoc = procFlag = "--"
    for objectName, data in MESSIER_CATALOG.items():
        rightascension, declination, commonName, apSize, obj_type, magnitude = data

        debug(f"\
{objectName:<10} \
{commonName:<20} \
{rightascension:>6.1f}° \
{declination:>6.1f}°  \
{magnitude:>6.2f} \
{apSize:>6.2f} \
{imageLoc:>20} \
{procFlag:>10}")

        sql = f"INSERT INTO kahaleobs.whatsUp set \
            objectName = \"{objectName}\", \
            commonName = \"{commonName}\", \
            rightascension = \"{rightascension}\", \
            declination = \"{declination}\", \
            magnitude = \"{magnitude}\", \
            apSize = \"{apSize}\", \
            imageLoc = \"{imageLoc}\", \
            procFlag = \"{procFlag}\" \
            ;"


        sql = f"UPDATE whatsUp set type = \"{obj_type}\" where objectName = \"{objectName}\""

        debug(f"DIAG sql: {sql}")

        try:
            cursor.execute(sql)
            conn.commit()
        except mysql.connector.Error as err:
            print(f"Database error: {err}")
            print(f"While added {objectName}")

    closeDB(conn, cursor)
                    
if __name__ == "__main__":
    main()
