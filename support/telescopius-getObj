BASE_URL = "https://api.telescopius.com/v2.2"
API_KEY = "4c4a21528fcfc7141bca5b3d6e8b60a4"

headers = {
    "Authorization": f"Key {API_KEY}",
    "Accept": "application/json"
}

def fetch_target_details(target_name):
    """Queries the Telescopius API for a specific deep-sky object's metadata."""
    # API query pattern mapping to the Telescopius targets database
    url = f"{BASE_URL}/targets/searchTargets"
    params = {
        "q": target_name
    }
    
    try:
        response = requests.get(url, headers=headers, params=params)
        response.raise_for_status()
        return response.json()
        
    except requests.exceptions.HTTPError as http_err:
        print(f"HTTP error occurred: {http_err}")
    except Exception as err:
        print(f"An error occurred: {err}")
    return None

if __name__ == "__main__":
    target = "M2"
    print(f"Fetching astronomical coordinates for {target}...")
