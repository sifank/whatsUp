#!/usr/bin/python3
# Program:	plite2mariaDB

import sqlite3
import mariadb
import sys

# 1. Database Configurations
sqlite_table = 'cat'

# Database Configuration
mariadb_config = {
    'host': 'depoe',
    'user': 'sifan',
    'password': 'all4Sky',
    'database': 'kahaleobs'
}

if len(sys.argv) !=2:
    print(f"Usage:  {sys.argv[0]} listFileName")
    sys.exit(1)
sqlite_file = sys.argv[1]

# 2. Column Mapping Configuration
# Map 'SQLite_Column_Name': 'MariaDB_Column_Name'
column_mapping = {
    'name': 'objectName',
    'long_name': 'commonName',
    'type': 'type',
    'ra': 'rightascension',
    'dec': 'declination',
    'magnitude': 'magnitude',
    'major_axis': 'apSize',
    'position_angle': 'PA'
}

# List any additional columns in MariaDB that you want to explicitly fill with NULL
additional_null_columns = ['imageLoc', 'procFlag']

try:
    # 3. Connect to SQLite and fetch data
    sqlite_conn = sqlite3.connect(sqlite_file)
    sqlite_cursor = sqlite_conn.cursor()

    sqlite_cols = list(column_mapping.keys())
    sqlite_csv = ', '.join(sqlite_cols)
    sqlite_cursor.execute(f"SELECT {sqlite_csv} FROM {sqlite_table}")
    rows = sqlite_cursor.fetchall()

    if not rows:
        print("Source table is empty. Exiting.")
        sys.exit()

    # 4. Transform data to include NULL values for the new columns
    # Appends None (Python's NULL) to the end of every row tuple
    #null_padding = (None,) * len(40)
    #transformed_rows = [row + null_padding for row in rows]

    # 5. Connect to MariaDB
    mariadb_conn = mariadb.connect(**mariadb_config)
    mariadb_cursor = mariadb_conn.cursor()

    # 6. Build the target MariaDB columns list
    mariadb_cols = list(column_mapping.values()) + additional_null_columns
    mariadb_csv = ', '.join(mariadb_cols)

    # 7. Build dynamic INSERT query
    placeholders = ', '.join(['?'] * len(mariadb_cols))
    sql_insert = f"INSERT IGNORE INTO {sqlite_table} ({mariadb_csv}) VALUES ({placeholders})"

    # 8. Insert transformed data into MariaDB
    mariadb_cursor.executemany(sql_insert, rows)
    mariadb_conn.commit()
    print(f"Successfully migrated {len(rows)} rows with renamed and padded columns to MariaDB.")

except mariadb.Error as e:
    print(f"Error connecting to MariaDB: {e}")
except sqlite3.Error as e:
    print(f"Error connecting to SQLite: {e}")
finally:
    # 9. Clean up connections
    if 'sqlite_cursor' in locals(): sqlite_cursor.close()
    if 'sqlite_conn' in locals(): sqlite_conn.close()
    if 'mariadb_cursor' in locals(): mariadb_cursor.close()
    if 'mariadb_conn' in locals(): mariadb_conn.close()
