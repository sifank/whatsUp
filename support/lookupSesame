     # --- 4: Globular Clusters ---
    "GlobCluster": 4, "GlbCl": 4, "GlC": 4,

    # --- 5: Gaseous Nebulae ---
    "Nebula": 5, "EmNebula": 5, "ReflNebula": 5, "DarkNebula": 5,
    "HII": 5, "Cloud": 5, "RfNeb": 5, "AsyNeb": 5,  "Neb": 5,  "PlNeb": 6,
    "DrkNeb": 15, "MolCld": 5, "RNe": 5, "DNe": 5, "ISM": 5,

    # --- 6: Planetary Nebulae ---
    "PlanetaryNeb": 6, "PN": 6, "PND": 6, "PN?": 6,

