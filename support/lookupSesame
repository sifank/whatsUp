    11: "Constellation",
    12: "Moon",
    13: "Asterism",
    14: "Galaxy Cluster",
    15: "Dark Nebula",
    16: "Quasar",
    17: "Multiple Star (Binary or Multi-star system)",
    18: "Radio Source",
    19: "Satellite",
    20: "Supernova ",
    99: "Unknown"
    }

# Map Simbad otype to KSTARS type
SIMBAD_TO_KSTARS = {
    # --- 0: Stars ---
    "Star": 0, "*": 0, "V*": 0, "Variable*": 0, "Double*": 0, "PM*": 0,
    "YSO": 0, "Be*": 0, "Carbon*": 0, "WhiteDwarf": 0, "Neutron*": 0,
    "SB*": 0,  "BY*": 0, "Em*": 0, "WR*": 0, "Be*": 0, "pA*": 0, "reg": 1,
