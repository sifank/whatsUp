    "QSO": 16, "PN": 6, "Unknown": 99
}

#--------------------------------------------------------
# Diag printout if DEBUG is true
def debug(msg):
    if DEBUG:
        print(f"DIAG {msg}")
    return

def lookup_object(object_name):
    """Looks up an object using the CDS Sesame Resolver with proper headers and mirrors."""
    encoded_name = urllib.parse.quote(object_name)

    # Alternative, high-availability mirror to bypass the connection block
    url = f"https://cdsweb.u-strasbg.fr/cgi-bin/nph-sesame/-oI/A?{encoded_name}"

    # Headers fake a regular web browser profile so the server doesn't reject you
    headers = {
        "User-Agent": (
            "Mozilla/5.0 (Windows NT 10.0; Win64; x64) "
            "AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
        )
    }

    try:
        # Pass the safety headers explicitly
        response = requests.get(url, headers=headers, timeout=10)
        response.raise_for_status()

        lines = response.text.splitlines()

        ra = None
        dec = None
        source = "Unknown"

        commonName = []
        for line in lines:
            debug(f"Line: {line}")
            if line.startswith("%J "):
                parts = line.split()
                if len(parts) >= 3:
                    ra = parts[1]
                    dec = parts[2]
            elif line.startswith("%C"):
                otype = line.replace("%C", "").strip()
                try:
                    otype = DSOTYPE[SIMBAD_TO_KSTARS[otype.removeprefix('.0 ')]]
                except:
                    otype = f"**{otype.removeprefix('.0 ')}**"
            elif line.startswith("%I "):
                commonName.append(line.removeprefix('%I ').removeprefix('NAME '))

        if ra is not None and dec is not None:
            return {
                "success": True,
                "name": object_name,
                "ra_deg": ra,
                "dec_deg": dec,
                "otype": otype,
                "commonName": " ".join(commonName)
            }

        return {
            "success": False,
            "error": f"Object '{object_name}' not found.",
        }

    except requests.exceptions.RequestException as e:
        return {"success": False, "error": f"HTTP Request failed: {e}"}
    except Exception as e:
        return {"success": False, "error": f"Parsing failed: {e}"}


# --- Main ---
if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Fetch Deep Sky Object metadata from SIMBAD.")
    parser.add_argument("object_name", type=str, help="Name of the object (e.g., M104, NGC 2244, Orion)")
    args = parser.parse_args()

    result = lookup_object(args.object_name)
    if result['success']:
        print(f"Name:  {result['name']} RA: {result['ra_deg']} Dec: {result['dec_deg']} Type: {result['otype']}")
    else:
        print(f"{args.object_name} {result['error']}")

